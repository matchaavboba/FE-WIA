# ============================================================
# RAMPUNG — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke repository.
# ============================================================

# --- URL Aplikasi ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK=true

# --- Supabase (NEXT_PUBLIC_ = boleh di client) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (SERVER ONLY — JANGAN PERNAH di client/NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Cloudflare Turnstile (anti-spam untuk pelapor anonim) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Rate Limiting (opsional, Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (opsional, untuk notifikasi email) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@rampung.surakarta.go.id

# --- AI Konten Verifikasi (opsional, Google Gemini 1.5 Flash Free Tier via aistudio.google.com) ---
# Jika dikosongkan, sistem otomatis menggunakan Rule-Based Sanitizer deterministik 100% gratis.
GEMINI_API_KEY=
